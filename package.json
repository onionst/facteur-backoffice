{
  "name": "backoffice-factcricis-svc",
  "version": "1.12.0",
  "private": true,
  "scripts": {
    "start:dev": "next dev",
    "start": "next start",
    "build": "rm -rf .next && next build",
    "lint": "next lint",
    "lint:fix": "npm run lint -- --fix",
    "docker:build": "docker build -t $REPO/$npm_package_name:$STAGE .",
    "docker:build:dev": "export STAGE=dev REPO=newtral && npm run docker:build",
    "docker:build:latest": "export STAGE=latest REPO=newtral && npm run docker:build",
    "docker:build:version": "export STAGE=$npm_package_version REPO=newtral && npm run docker:build",
    "docker:push": "docker push $REPO/$npm_package_name:$STAGE",
    "docker:push:dev": "export STAGE=dev REPO=newtral && npm run docker:push",
    "docker:push:latest": "export STAGE=latest REPO=newtral && npm run docker:push",
    "docker:push:version": "export STAGE=$npm_package_version REPO=newtral && npm run docker:push",
    "release": "bash ./tools/bin/release",
    "release:alpha": "bash ./tools/bin/release --prerelease alpha",
    "release:beta": "bash ./tools/bin/release --prerelease beta",
    "release:major": "bash ./tools/bin/release --release-as major",
    "pre-commit": "test -f .husky/pre-commit && echo 'pre-commit already installed' || npx husky add .husky/pre-commit 'npm run lint'",
    "pre-push": "test -f .husky/pre-push && echo 'pre-push already installed' || npx husky add .husky/pre-push 'npm run lint:fix'",
    "prepare": "husky install && npm run pre-commit && npm run pre-push || exit 0"
  },
  "engines": {
    "node": ">=18.10.x",
    "npm": ">=8.19.x"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@babel/runtime": "^7.23.6",
    "@formatjs/intl-pluralrules": "5.2.4",
    "@formatjs/intl-relativetimeformat": "11.2.4",
    "@fortawesome/fontawesome-free": "6.1.1",
    "@popperjs/core": "^2.11.6",
    "@types/node": "20.10.4",
    "@types/react": "18.2.43",
    "@types/react-dom": "18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "ai": "^2.2.27",
    "animate.css": "4.1.1",
    "antd": "^5.6.3",
    "autoprefixer": "10.4.16",
    "axios": "^1.6.2",
    "bootstrap": "5.3.0",
    "bootstrap-icons": "^1.5.0",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "line-awesome": "1.3.0",
    "llamaindex": "0.0.38",
    "next": "^13.5.6",
    "next-plugin-antd-less": "^1.8.0",
    "nouislider": "15.5.1",
    "prism-react-renderer": "2.0.5",
    "prism-themes": "1.9.0",
    "prismjs": "1.28.0",
    "react": "18.2.0",
    "react-bootstrap": "2.5.0-beta.1",
    "react-dom": "18.2.0",
    "react-dropzone": "^14.2.3",
    "react-feather": "^2.0.10",
    "react-flatpickr": "^3.10.13",
    "react-inlinesvg": "3.0.0",
    "sass": "^1.69.5",
    "socicon": "3.0.5",
    "store": "^2.0.12",
    "typescript": "5.3.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.6",
    "@types/react-gravatar": "^2.6.14",
    "@types/store": "^2.0.5",
    "eslint": "^8.56.0",
    "eslint-config-next": "^13.5.6",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "nyc": "^15.1.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "standard-version": "^9.5.0",
    "tailwindcss": "^3.3.6"
  },
  "husky": {
    "hooks": {
      "pre-push": "npm run lint:fix",
      "pre-commit": "npm run lint"
    }
  },
  "standard-version": {
    "scripts": {
      "postchangelog": "./tools/bin/postchangelog"
    },
    "commitUrlFormat": "{{host}}/{{owner}}/{{repository}}/commits/{{hash}}",
    "compareUrlFormat": "{{host}}/{{owner}}/{{repository}}/branches/compare/{{currentTag}}%0D{{previousTag}}#diff"
  }
}
